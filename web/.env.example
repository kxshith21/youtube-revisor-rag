# Copy to .env.local for local development.

# FastAPI backend (run from the project root):
#   uvicorn app.main:app --reload --port 8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Stream canned answers without the backend, for UI development.
NEXT_PUBLIC_MOCK=false

# Do NOT put GROQ_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY here.
# Only NEXT_PUBLIC_* variables reach the browser.
