# Copy to .env and fill in real values. NEVER commit the real .env file.

# --- LLM provider (scripts/generate.py) ---
LLM_PROVIDER=groq
# Groq example; check the provider docs for current model names.
LLM_MODEL=openai/gpt-oss-20b

# Put the key for the chosen provider here (leave the others blank).
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: only for LLM_PROVIDER=openai/ollama (local models need no key).
# Ollama example: OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=
MAX_TOKENS=1000
TEMPERATURE=0.2

# --- Qdrant (local Docker needs NO key; only set this for Qdrant Cloud) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Backend (app/) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Optional API key auth. If empty, auth is disabled for local development.
API_KEY=

# Requests per minute, per IP (integers).
RATE_LIMIT_SEARCH=30
RATE_LIMIT_ASK=10

LOG_LEVEL=INFO
ASK_TIMEOUT_S=30
STREAM_TIMEOUT_S=60
STREAM_HEARTBEAT_S=15

# In-memory cache for /ask, /topics and /videos.
CACHE_TTL_S=600
CACHE_MAX_ENTRIES=500
